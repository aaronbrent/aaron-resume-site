{
  "ci": {
    "collect": {
      "url": ["http://localhost:4810/", "http://localhost:4810/resume/"],
      "numberOfRuns": 3,
      "startServerCommand": "node scripts/serve.mjs --port 4810",
      "startServerReadyPattern": "Serving build/client"
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.85
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 430080
          }
        ],
        "resource-summary:stylesheet:size": [
          "error",
          {
            "maxNumericValue": 35840
          }
        ],
        "resource-summary:font:size": [
          "error",
          {
            "maxNumericValue": 122880
          }
        ],
        "resource-summary:image:size": [
          "error",
          {
            "maxNumericValue": 122880
          }
        ],
        "resource-summary:total:size": [
          "error",
          {
            "maxNumericValue": 921600
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
