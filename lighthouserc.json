{
  "ci": {
    "collect": {
      "staticDistDir": "./build/client",
      "url": ["http://localhost/", "http://localhost/resume/"],
      "numberOfRuns": 3,
      "settings": {
        "budgetsPath": "./budgets.json"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.85
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 430080
          }
        ],
        "resource-summary:stylesheet:size": [
          "error",
          {
            "maxNumericValue": 35840
          }
        ],
        "resource-summary:font:size": [
          "error",
          {
            "maxNumericValue": 122880
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
